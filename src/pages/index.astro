---
import BaseLayout from '../layouts/BaseLayout.astro';
import { experience, projects, seo, site, skillGroups } from '../data/site';

const avatarUrl = new URL(site.avatarPath, `${site.url}/`).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: site.name,
    url: site.url,
    image: avatarUrl,
    jobTitle: 'Cloud Infrastructure Engineer',
    description: seo.description,
    email: site.email,
    sameAs: [
      'https://github.com/lponik',
      'https://www.linkedin.com/in/logan-ponik/',
      'https://devpost.com/software/nutrify-y1htqm',
    ],
    alumniOf: {
      '@type': 'CollegeOrUniversity',
      name: 'University of Delaware',
    },
    knowsAbout: ['Cloud Infrastructure', 'Linux Systems', 'AWS', 'Terraform', 'Networking', 'Automation', 'Observability'],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: `${site.name} Portfolio`,
    url: site.url,
  },
];
---

<BaseLayout
  canonical={site.url}
  description={seo.description}
  jsonLd={jsonLd}
  keywords={seo.keywords}
  ogImage={avatarUrl}
  title={seo.title}
>
  <header class="site-header">
    <div class="page-shell header-inner">
      <a class="terminal-id" href="#top" aria-label="Back to top">logan@portfolio:~</a>
      <nav aria-label="Primary navigation">
        <ul class="nav-list">
          {site.navigation.map(({ id, label }) => (
            <li><a href={`#${id}`}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </header>

  <main class="page-shell page-content">
    <section class="intro" id="top" aria-labelledby="intro-title">
      <h1 id="intro-title">{site.name}</h1>
      <div class="intro-credentials" aria-label="Education and certification">
        <p>{site.degree} · {site.graduation}</p>
        <p>{site.certification}</p>
      </div>
      <ul class="text-links" aria-label="Profile links">
        {site.profileLinks.map((link) => (
          <li>
            <a
              href={link.href}
              download={'download' in link ? link.download : undefined}
              rel={link.href.startsWith('http') ? 'noreferrer' : undefined}
              target={link.href.startsWith('http') ? '_blank' : undefined}
            >
              {link.label} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="content-section" id="about" aria-labelledby="about-title">
      <h2 class="command-heading" id="about-title">About</h2>
      <p class="about-copy">{site.about}</p>
    </section>

    <section class="content-section" id="experience" aria-labelledby="experience-title">
      <h2 class="command-heading" id="experience-title">Experience</h2>
      <div class="experience-list">
        <article class="experience-entry">
          <div class="entry-heading-row">
            <h3>{experience.company}</h3>
            <p class="entry-period">{experience.period}</p>
          </div>
          <p class="entry-role">{experience.role}</p>
          <ul class="experience-highlights">
            {experience.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>
          <p class="technology-list">{experience.technologies.join(' · ')}</p>
        </article>
      </div>
    </section>

    <section class="content-section" id="skills" aria-labelledby="skills-title">
      <h2 class="command-heading" id="skills-title">Skills</h2>
      <dl class="skill-list">
        {skillGroups.map(({ title, skills }) => (
          <div class="skill-row">
            <dt>{title}</dt>
            <dd>{skills.join(' · ')}</dd>
          </div>
        ))}
      </dl>
    </section>

    <section class="content-section" id="projects" aria-labelledby="projects-title">
      <h2 class="command-heading" id="projects-title">Projects</h2>
      <div class="project-list">
        {projects.map((project, index) => (
          <article class="project-entry">
            <div class="project-heading-row">
              <p class="project-number">{String(index + 1).padStart(2, '0')} /</p>
              <h3>{project.title}</h3>
            </div>
            <p class="entry-description">{project.description}</p>
            <p class="technology-list">{project.technologies.join(' · ')}</p>
            <div class="project-links">
              <a class="entry-link" href={project.githubUrl} rel="noreferrer" target="_blank">
                GitHub <span aria-hidden="true">↗</span>
              </a>
              {'liveUrl' in project && (
                <a class="entry-link" href={project.liveUrl} rel="noreferrer" target="_blank">
                  Live site <span aria-hidden="true">↗</span>
                </a>
              )}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="content-section contact-section" id="contact" aria-labelledby="contact-title">
      <h2 class="command-heading" id="contact-title">Contact</h2>
      <p class="contact-copy">{site.contact}</p>
      <ul class="text-links" aria-label="Contact links">
        <li><a href={site.email}>Email <span aria-hidden="true">↗</span></a></li>
      </ul>
    </section>
  </main>
</BaseLayout>
